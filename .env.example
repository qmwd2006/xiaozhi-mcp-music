# ===== 小智 MCP 接入点 =====
# 登录小智控制台（xiaozhi.me），进入智能体 -> 配置角色页面，
# 复制该智能体专属的 MCP 接入点地址：
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=在此填写你的token

# ===== 音乐源 =====
# 可用: kuwo(酷我) netease(网易云) migu(咪咕) kugou(酷狗) bilibili(B站)
MUSIC_SOURCES=kuwo,netease,migu,kugou,bilibili

# ===== 网络 =====
SOURCE_TIMEOUT=15
# 如需要代理（例如某些网络环境），取消注释：
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ===== 播放 =====
# 本地播放器: none / mpv / vlc（小智硬件播放不需要本地播放器）
LOCAL_PLAYER=none
AUTO_PLAY_LOCAL=false
# 播放地址解析失败时最多尝试的候选歌曲数
MAX_RESOLVE_TRIES=6
# resource/read 单页最大字节数（小智默认每页 100KB）
MAX_PAGE_SIZE=1048576

# ===== 其他 =====
LOG_LEVEL=INFO
CACHE_DIR=./cache

# ===== 内置音频流服务（B站等需要服务端转码的音源）=====
# 监听端口
STREAM_PORT=8099
# 设备访问本机流服务的主机地址，必须是设备能访问到的局域网 IP；
# 留空则自动探测本机出口网卡 IP
STREAM_PUBLIC_HOST=
# ffmpeg 可执行文件路径（默认使用 PATH 中的 ffmpeg）
# FFMPEG=ffmpeg

# ===== 本地曲库 =====
# 已转码/播放过的歌曲持久保存在此目录，可离线重播，不会被自动清理
LIBRARY_DIR=./library

# ===== Docker 部署（可选）=====
# 镜像 tag：latest 跟随最新构建；生产建议固定为 sha-xxxxxxxx 或 vX.Y.Z
MUSIC_MCP_TAG=latest
# 容器内日志级别（默认 INFO；DEBUG 会产生大量 JSON-RPC 帧日志）
# MUSIC_LOG_LEVEL=INFO
# 容器内自动探测到的 IP 是 172.x，必须显式指定设备可访问的局域网地址
# STREAM_PUBLIC_HOST=192.168.31.178
